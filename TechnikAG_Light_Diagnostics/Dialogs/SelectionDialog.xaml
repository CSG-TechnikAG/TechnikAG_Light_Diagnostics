<Window x:Class="TechnikAG_Light_Diagnostics.Dialogs.SelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select"
        Width="620"
        Height="540"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   FontSize="22"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="SubText"
                   Grid.Row="1"
                   Margin="0,6,0,0"
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Margin="0,18"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6">
            <ListBox x:Name="ItemsList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Subtitle}"
                                       Margin="0,3,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="NoteText"
                   Grid.Row="3"
                   Margin="0,0,0,14"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SelectAllButton"
                    Content="Select all"
                    Style="{StaticResource GhostButton}"
                    Click="SelectAll_Click"
                    Visibility="Collapsed" />

            <Button x:Name="CancelButton"
                    Grid.Column="2"
                    Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    IsCancel="True"
                    MinWidth="100"
                    Margin="0,0,10,0" />

            <Button x:Name="ConfirmButton"
                    Grid.Column="3"
                    Content="Continue"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    MinWidth="150" />
        </Grid>
    </Grid>
</Window>
