<Window x:Class="TechnikAG_Light_Diagnostics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Technik-AG Light Diagnostics"
        Width="1180"
        Height="840"
        MinWidth="1020"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0"
                Height="40"
                Padding="14,0"
                Background="{DynamicResource PrimaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Source="/Resources/icons8-light-1000.png"
                           Width="21"
                           Height="21"
                           Stretch="Uniform" />
                    <TextBlock Text="Technik-AG"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ContrastBrush}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <Border Width="1"
                            Height="14"
                            Margin="10,0"
                            Background="{DynamicResource ContrastBrush}"
                            Opacity="0.3" />
                    <TextBlock Text="Light Diagnostics"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ContrastBrush}"
                               FontSize="12"
                               Opacity="0.68" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="VersionBadge"
                               Text="v1.1.0"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ContrastBrush}"
                               FontSize="12"
                               Opacity="0.68" />
                    <Button x:Name="CheckUpdatesButton"
                            Style="{StaticResource TopBarIconButton}"
                            Click="CheckUpdates_Click"
                            ToolTip="Check for updates"
                            AutomationProperties.Name="Check for updates">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource ContrastBrush}" />
                    </Button>
                    <Button x:Name="ThemeToggleButton"
                            Style="{StaticResource TopBarIconButton}"
                            Click="ThemeToggle_Click"
                            Margin="2,0,0,0"
                            ToolTip="Switch to dark theme"
                            AutomationProperties.Name="Toggle theme">
                        <TextBlock x:Name="ThemeToggleGlyph"
                                   Text="&#xE708;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource ContrastBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Page -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,16,16,0">

                <!-- Hero -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1">
                    <Border BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="4,0,0,0"
                            Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Light Diagnostics"
                                           Style="{StaticResource HeroTitle}" />
                                <TextBlock Text="Maintenance and recovery for the Technik-AG lighting setup. Install, update and remove QLC+, fixture definitions and USB-DMX drivers."
                                           Margin="0,4,0,0"
                                           MaxWidth="760"
                                           HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="235"
                                    Height="72"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource BannerBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Image Source="/Resources/icons8-light-1000.png"
                                       Margin="10,7"
                                       Stretch="Uniform" />
                            </Border>
                        </Grid>
                    </Border>
                </Border>

                <!-- Update banner -->
                <Border x:Name="UpdateBanner"
                        Margin="0,14,0,0"
                        Background="{DynamicResource AccentSofterBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Border BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="4,0,0,0"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Update available"
                                           FontSize="13"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="UpdateBannerText"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button x:Name="UpdateNowButton"
                                    Grid.Column="1"
                                    Content="Download &amp; install"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="UpdateNow_Click"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0" />
                        </Grid>
                    </Border>
                </Border>

                <!-- Section toolbar -->
                <Border Margin="0,18,0,0"
                        Padding="11,8"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="System components"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="QLC+, fixture definitions and USB-DMX drivers on this workstation"
                                   Margin="10,0,16,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="CDN: cdn.by-cra.net"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">

                        <!-- QLC+ / QLC++ -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource CardIconBorderStyle}">
                                        <Image Source="/Resources/ybDunOe.png"
                                               Width="28"
                                               Height="28"
                                               Stretch="Uniform" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,16,0">
                                        <TextBlock Text="QLC+ / QLC++" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Install, update or remove the three supported QLC+ architectures."
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                        <Button x:Name="QlcRefreshButton"
                                                Content="Refresh versions"
                                                Style="{StaticResource GhostButton}"
                                                Click="QlcRefresh_Click"
                                                MinWidth="140" />
                                        <Button x:Name="QlcUninstallButton"
                                                Content="Remove installation"
                                                Style="{StaticResource DangerButton}"
                                                Click="QlcUninstall_Click"
                                                MinWidth="140"
                                                Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource DividerStyle}" Margin="0,14,0,0" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="QLC+ 4" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Official QLC+ 4 series with the Qt Widgets interface. Installs to C:\QLC+."
                                                   Margin="0,3,0,0"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="QlcPlus4StatusText"
                                                   Text="Not checked yet."
                                                   Margin="0,6,0,0"
                                                   Style="{StaticResource StatusTextStyle}" />
                                    </StackPanel>

                                    <Button x:Name="QlcPlus4InstallButton"
                                            Grid.Column="1"
                                            Content="Install"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="QlcPlus4Install_Click"
                                            MinWidth="120"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <Border Style="{StaticResource DividerStyle}" Margin="0,12,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="QLC+ 5" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Official QLC+ 5 series with the QML interface. Installs to C:\QLC+5 alongside QLC+ 4."
                                                   Margin="0,3,0,0"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="QlcPlus5StatusText"
                                                   Text="Not checked yet."
                                                   Margin="0,6,0,0"
                                                   Style="{StaticResource StatusTextStyle}" />
                                    </StackPanel>

                                    <Button x:Name="QlcPlus5InstallButton"
                                            Grid.Column="1"
                                            Content="Install"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="QlcPlus5Install_Click"
                                            MinWidth="120"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <Border Style="{StaticResource DividerStyle}" Margin="0,12,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="QLC++" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="TechnikAG QLC++ build. It is hosted on the CDN and installs into C:\QLC++."
                                                   Margin="0,3,0,0"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="QlcPlusCppStatusText"
                                                   Text="Not checked yet."
                                                   Margin="0,6,0,0"
                                                   Style="{StaticResource StatusTextStyle}" />
                                    </StackPanel>

                                    <Button x:Name="QlcPlusCppInstallButton"
                                            Grid.Column="1"
                                            Content="Install"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="QlcPlusCppInstall_Click"
                                            MinWidth="120"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Fixtures -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardIconBorderStyle}">
                                    <Image Source="/Resources/icons8-source-four-par-100.png"
                                           Width="26"
                                           Height="26"
                                           Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,16,0">
                                    <TextBlock Text="Fixture Definitions" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Install the Technik-AG fixture library into the current user's QLC+ profile."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="FixtureStatusText"
                                               Text="Not checked yet."
                                               Margin="0,8,0,0"
                                               Style="{StaticResource StatusTextStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">
                                    <Button x:Name="FixtureInstallButton"
                                            Content="Install / update"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="FixtureInstall_Click"
                                            MinWidth="138" />
                                    <Button x:Name="FixtureUninstallButton"
                                            Content="Uninstall"
                                            Style="{StaticResource DangerButton}"
                                            Click="FixtureUninstall_Click"
                                            MinWidth="138"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Drivers -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardIconBorderStyle}">
                                    <Image Source="/Resources/icons8-software-installer-100.png"
                                           Width="26"
                                           Height="26"
                                           Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,16,0">
                                    <TextBlock Text="DMX Drivers" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Install or remove FTDI drivers for USB-DMX interfaces. Use this when the interface is not detected."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="DriverStatusText"
                                               Text="Not checked yet."
                                               Margin="0,8,0,0"
                                               Style="{StaticResource StatusTextStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">
                                    <Button x:Name="DriverInstallButton"
                                            Content="Install / update"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="DriverInstall_Click"
                                            MinWidth="138" />
                                    <Button x:Name="DriverUninstallButton"
                                            Content="Uninstall"
                                            Style="{StaticResource DangerButton}"
                                            Click="DriverUninstall_Click"
                                            MinWidth="138"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- Activity -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource PrimaryBrush}" Padding="11,9">
                                <StackPanel>
                                    <TextBlock Text="Activity"
                                               Foreground="{DynamicResource ContrastBrush}"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Live log for version checks and downloads"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource ContrastBrush}"
                                               FontSize="10"
                                               Opacity="0.72" />
                                </StackPanel>
                            </Border>

                            <ListBox x:Name="ActivityLog"
                                     Grid.Row="1"
                                     Margin="12,10,6,12"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Focusable="False"
                                     IsTabStop="False"
                                     ItemContainerStyle="{StaticResource LogItemStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Margin="16,0,16,0"
                Padding="0,14,0,18"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <ProgressBar x:Name="Progress"
                                 Margin="0,8,0,0"
                                 Width="420"
                                 HorizontalAlignment="Left"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="ProgressDetailText"
                               Margin="0,4,0,0"
                               Style="{StaticResource SmallMutedText}"
                               Visibility="Collapsed"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="© CodeRebelsAlliance 2026"
                           VerticalAlignment="Center"
                           Style="{StaticResource SmallMutedText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
