<Window x:Class="TechnikAG_Light_Diagnostics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Technik-AG Light Diagnostics"
        Width="1040"
        Height="780"
        MinWidth="940"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#0E131C"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="58"
                        Height="58"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Image Source="/Resources/icons8-light-1000.png"
                           Width="38"
                           Height="38"
                           Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="16,0,24,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Technik-AG Light Diagnostics"
                               FontSize="23"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Maintenance and recovery for the lighting setup"
                               Margin="0,3,0,0"
                               Style="{StaticResource MutedText}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#16294D"
                            BorderBrush="#2E4F8C"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="11,6"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="VersionBadge"
                                   Text="v1.0.0"
                                   Foreground="#A9C2FF"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>

                    <Button x:Name="CheckUpdatesButton"
                            Content="Check for updates"
                            Style="{StaticResource GhostButton}"
                            Click="CheckUpdates_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Update banner -->
        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                Margin="24,16,24,0"
                Padding="16,12"
                Background="#142748"
                BorderBrush="#2D5BA6"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Update available"
                               FontWeight="SemiBold"
                               Foreground="#BBD0FF"
                               FontSize="13" />
                    <TextBlock x:Name="UpdateBannerText"
                               Margin="0,2,0,0"
                               Foreground="#8FA9DC"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button x:Name="UpdateNowButton"
                        Grid.Column="1"
                        Content="Download &amp; install"
                        Style="{StaticResource PrimaryButton}"
                        Click="UpdateNow_Click"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2" Margin="24,18,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          Margin="0,0,16,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- QLC+ / QLC++ -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="48"
                                        Height="48"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        CornerRadius="12"
                                        VerticalAlignment="Top">
                                    <Image Source="/Resources/ybDunOe.png"
                                           Width="32"
                                           Height="32"
                                           Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,20,0">
                                    <TextBlock Text="QLC+ / QLC++" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Install, update or remove the three supported QLC+ architectures. All version lists and installers come from cdn.by-cra.net."
                                               Margin="0,6,0,0"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <Button x:Name="QlcRefreshButton"
                                            Content="Refresh versions"
                                            Style="{StaticResource GhostButton}"
                                            Click="QlcRefresh_Click"
                                            MinWidth="156" />
                                    <Button x:Name="QlcUninstallButton"
                                            Content="Remove installation"
                                            Style="{StaticResource DangerButton}"
                                            Click="QlcUninstall_Click"
                                            MinWidth="156"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    Margin="0,18,0,18" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="QLC+ 4"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Official QLC+ 4 series with the Qt Widgets interface. Installs to C:\QLC+."
                                               Margin="0,3,0,0"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="QlcPlus4StatusText"
                                               Text="Not checked yet."
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button x:Name="QlcPlus4InstallButton"
                                        Grid.Column="1"
                                        Content="Install"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="QlcPlus4Install_Click"
                                        MinWidth="120"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    Margin="0,14,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="QLC+ 5"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Official QLC+ 5 series with the QML interface. Installs to C:\QLC+5 alongside QLC+ 4."
                                               Margin="0,3,0,0"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="QlcPlus5StatusText"
                                               Text="Not checked yet."
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button x:Name="QlcPlus5InstallButton"
                                        Grid.Column="1"
                                        Content="Install"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="QlcPlus5Install_Click"
                                        MinWidth="120"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    Margin="0,14,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="QLC++"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="TechnikAG QLC++ build. It is hosted on the CDN and installs like QLC+ 4 into C:\QLC+."
                                               Margin="0,3,0,0"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="QlcPlusCppStatusText"
                                               Text="Not checked yet."
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button x:Name="QlcPlusCppInstallButton"
                                        Grid.Column="1"
                                        Content="Install"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="QlcPlusCppInstall_Click"
                                        MinWidth="120"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Fixtures -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="48"
                                    Height="48"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                <Image Source="/Resources/icons8-source-four-par-100.png"
                                       Width="32"
                                       Height="32"
                                       Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,20,0">
                                <TextBlock Text="Fixture Definitions" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Install the Technik-AG fixture library into the current user's QLC+ profile."
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="FixtureStatusText"
                                           Text="Not checked yet."
                                           Margin="0,10,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="FixtureInstallButton"
                                        Content="Install / update"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="FixtureInstall_Click"
                                        MinWidth="138" />
                                <Button x:Name="FixtureUninstallButton"
                                        Content="Uninstall"
                                        Style="{StaticResource DangerButton}"
                                        Click="FixtureUninstall_Click"
                                        MinWidth="138"
                                        Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Drivers -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="48"
                                    Height="48"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                <Image Source="/Resources/icons8-software-installer-100.png"
                                       Width="32"
                                       Height="32"
                                       Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,20,0">
                                <TextBlock Text="DMX Drivers" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Install or remove FTDI drivers for USB-DMX interfaces. Use this when the interface is not detected."
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DriverStatusText"
                                           Text="Not checked yet."
                                           Margin="0,10,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="DriverInstallButton"
                                        Content="Install / update"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="DriverInstall_Click"
                                        MinWidth="138" />
                                <Button x:Name="DriverUninstallButton"
                                        Content="Uninstall"
                                        Style="{StaticResource DangerButton}"
                                        Click="DriverUninstall_Click"
                                        MinWidth="138"
                                        Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Activity -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Activity"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1"
                               Text="Live log for version checks and downloads"
                               Margin="0,3,0,0"
                               Style="{StaticResource SmallMutedText}" />
                    <ListBox x:Name="ActivityLog"
                             Grid.Row="2"
                             Margin="0,12,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             Focusable="False"
                             IsTabStop="False"
                             ItemContainerStyle="{StaticResource LogItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="#0E131C"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <ProgressBar x:Name="Progress"
                                 Margin="0,8,0,0"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="ProgressDetailText"
                               Margin="0,4,0,0"
                               Style="{StaticResource SmallMutedText}"
                               Visibility="Collapsed"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Downloads &amp; version checks: cdn.by-cra.net"
                           VerticalAlignment="Center"
                           Style="{StaticResource SmallMutedText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
